programa
{
	
	funcao inicio()
	{
		real   v1 
		escreva("digite um numero real\n")
		leia(v1)
		se (v1 >=0 ){
		 v1 = v1*2
		 escreva(v1)
		}senao{
		  v1 = v1*3
		  escreva(v1)
		}
		
		
	}
}

programa
{
	
	funcao inicio()
	{
		real not1,not2
		escreva("Digite sua nota de Português: ")
		leia(not1)
		escreva("Digite sua nota de Matemática: ")
		leia(not2)
		
		se ((not1+not2)/2 >= 6.0){
			escreva("Aprovado")
		}
		
		se ((not1+not2)/2 < 6.0){
			escreva("PERDEU AURA!!! KAKAKAKAKAKAKA")
		}
		
	}
}

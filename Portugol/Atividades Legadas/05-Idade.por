programa
{
	
	funcao inicio()
	{
		inteiro ANO_ATUAL
		inteiro ANO_DE_NASCIMENTO
		escreva("digite o  ano atual")
		leia(ANO_ATUAL)
		escreva("ano de nascimeto")
		leia(ANO_DE_NASCIMENTO)
		escreva("a sua idade e",ANO_ATUAL-ANO_DE_NASCIMENTO)
		
		
	}    
}


programa
{
	
	funcao inicio()
	{
		inteiro BASE, AREA, ALTURA

		escreva("Digite a BASE: \n>> ")
		leia(BASE)
		
		escreva("Digite a ALTURA: \n>> ")
		leia(ALTURA)
		
		AREA = (BASE*ALTURA)/2
		escreva("A área do seu triângulo é: ",AREA,"\n")
	}
}
